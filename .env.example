# ============================================================
# MemoAI — .env.example (template safe à committer)
# Copie ce fichier et remplis les vraies valeurs dans .env
# ============================================================

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-python-secrets
DEBUG=False
ALLOWED_HOSTS=your-domain.onrender.com,localhost
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_LOG_LEVEL=WARNING
FRONTEND_URL=https://your-domain.onrender.com

# ── Database — Neon DB (PostgreSQL serverless) ───────────────
# Récupère l'URL depuis https://console.neon.tech/
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://memoai_user:password@ep-xxx.neon.tech/memoai?sslmode=require
USE_SQLITE=False
DB_ENGINE=postgresql
DB_NAME=memoai
DB_USER=memoai_user
DB_PASSWORD=change-me
DB_HOST=ep-xxx-xxxx.neon.tech
DB_PORT=5432

# ── Redis & Celery ───────────────────────────────────────────
# Sur Render, Celery tourne en mode eager (pas de Redis sur free tier)
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ALWAYS_EAGER=True

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Image Generation ──────────────────────────────────────────
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_GENERATION_MODEL=flux
IMAGE_GENERATION_WIDTH=896
IMAGE_GENERATION_HEIGHT=576

# ── Hugging Face ──────────────────────────────────────────────
HUGGINGFACE_API_KEY=your_hf_api_key
HUGGINGFACE_ASR_MODEL=openai/whisper-large-v3
HUGGINGFACE_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# ── Email ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=MemoAI <noreply@memoai.app>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# ── Pexels ────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key
PEXELS_API_BASE_URL=https://api.pexels.com/v1

# ── Media ─────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_MINUTES=60

# ── Face Recognition ──────────────────────────────────────────
FACE_RECOGNITION_ENABLED=True
FACE_RECOGNITION_CONFIDENCE_THRESHOLD=0.6

# ── CORS / CSRF (production) ──────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-domain.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-domain.onrender.com
