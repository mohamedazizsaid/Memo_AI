# ============================================================
# MemoAI — .env.docker (variables pour Docker Compose local)
# ============================================================
# Copie ce fichier : cp .env.docker .env.docker.local
# Ne jamais committer les vraies valeurs en production !
# ============================================================

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-in-production-docker
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_SETTINGS_MODULE=config.settings

# ── Database (PostgreSQL via Docker service "db") ────────────
USE_SQLITE=False
DB_ENGINE=postgresql
DB_NAME=memoai
DB_USER=memoai_user
DB_PASSWORD=memoai_password
DB_HOST=db
DB_PORT=5432

# ── Redis & Celery ───────────────────────────────────────────
USE_REDIS=True
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_ALWAYS_EAGER=False

# ── Cloudinary (remplace par tes vraies clés) ─────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Image Generation (Pollinations — gratuit, sans clé) ───────
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_GENERATION_MODEL=flux
IMAGE_GENERATION_WIDTH=896
IMAGE_GENERATION_HEIGHT=576

# ── Hugging Face ──────────────────────────────────────────────
HUGGINGFACE_API_KEY=your_hf_api_key
HUGGINGFACE_ASR_MODEL=openai/whisper-large-v3
HUGGINGFACE_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# ── Email (Gmail SMTP) ────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=MemoAI <noreply@memoai.app>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# ── Pexels ────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key
PEXELS_API_BASE_URL=https://api.pexels.com/v1

# ── Media ─────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_MINUTES=60

# ── Face Recognition ──────────────────────────────────────────
FACE_RECOGNITION_ENABLED=True
FACE_RECOGNITION_CONFIDENCE_THRESHOLD=0.6
